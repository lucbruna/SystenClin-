<UserControl x:Class="Systenclin.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="100"
             Focusable="False"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100">
            <!-- Trilho -->
            <Ellipse Stroke="{StaticResource Line}" StrokeThickness="7" Margin="6" />

            <!-- Arco de valor (glow só no elemento pequeno, sem texto dentro) -->
            <Path x:Name="ValueArc"
                  Stroke="{StaticResource Accent}"
                  StrokeThickness="7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Effect="{StaticResource GlowSoft}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ValueLabel" Text="0%"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource Fg}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CaptionLabel" Text=""
                           FontSize="10.5"
                           Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="76" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
