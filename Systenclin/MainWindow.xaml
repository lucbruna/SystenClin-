<Window x:Class="Systenclin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Systenclin.L10n"
        xmlns:ctl="clr-namespace:Systenclin.Controls"
        Title="Systenclin" l:Tr.Key="systenclin"
        Height="780" Width="1140"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- cabeçalho -->
            <RowDefinition Height="Auto" />   <!-- abas -->
            <RowDefinition Height="*" />      <!-- conteúdo -->
            <RowDefinition Height="Auto" />   <!-- rodapé -->
        </Grid.RowDefinitions>

        <!-- ══════════════ Cabeçalho ══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderTitle" Text="Limpeza de arquivos temporários"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Nada foi apagado ainda. Clique em Analisar para ver o que dá para liberar."
                               FontSize="12.5" Foreground="{StaticResource Dim}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0,0,0">
                    <ctl:CircularGauge x:Name="DiskUsageGauge" Width="48" Height="48"
                                       Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FreeSpaceText" FontSize="12.5"
                               Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ Abas ══════════════ -->
        <Border Grid.Row="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <RadioButton x:Name="TabFiles" Style="{StaticResource TabButton}"
                             GroupName="Tabs" IsChecked="True"
                             Checked="Tab_Changed" Tag="files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Arquivos" l:Tr.Key="arquivos" FontSize="13.5" />
                        <Border x:Name="FilesBadge" Background="{StaticResource Accent}"
                                CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="FilesBadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnAccent}" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabPrivacy" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="privacy">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Privacidade" l:Tr.Key="privacidade" FontSize="13.5" />
                        <Border x:Name="PrivacyBadge" Background="{StaticResource Accent}"
                                CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="PrivacyBadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnAccent}" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabOptimize" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="optimize">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Otimização" l:Tr.Key="otimizacao" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabDuplicates" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="duplicates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Duplicados" l:Tr.Key="duplicados" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabShortcuts" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Atalhos" l:Tr.Key="atalhos" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabApps" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="apps">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Aplicativos" l:Tr.Key="aplicativos" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabLargeFiles" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="largefiles">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Arquivos grandes" l:Tr.Key="arquivos_grandes" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabSpace" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="space">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Espaço" l:Tr.Key="espaco" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ══════════════ Conteúdo ══════════════ -->
        <Grid Grid.Row="2" Margin="28,20,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- aviso de navegador aberto -->
                <RowDefinition Height="*" />      <!-- lista -->
                <RowDefinition Height="Auto" />   <!-- barra de status -->
            </Grid.RowDefinitions>

            <!-- Aviso: navegadores abertos -->
            <Border Grid.Row="0" x:Name="BrowserWarning" Visibility="Collapsed"
                    Background="{StaticResource WarnPanel}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="18"
                               Foreground="{StaticResource Warn}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="BrowserWarningTitle" FontSize="13.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource WarnText}" />
                        <TextBlock x:Name="BrowserWarningBody" FontSize="12.5"
                                   Foreground="{StaticResource WarnTextDim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado vazio / varrendo -->
            <Border x:Name="EmptyState" Grid.Row="1"
                    Style="{StaticResource Card}" Padding="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="560">
                    <TextBlock x:Name="EmptyIcon" Text="🔍" FontSize="46"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock x:Name="EmptyTitle" Text="Pronto para analisar"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody"
                               Text="A análise só lê o disco: mede o tamanho das pastas de cache e lista o que pode ser liberado. Nenhum arquivo é tocado até você confirmar."
                               FontSize="13.5" Foreground="{StaticResource Dim}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0" />

                    <!-- O botão de analisar fica SEMPRE visível: é a única porta
                         de entrada do app. Sem ele no estado vazio, não há como
                         começar. -->
                    <Button x:Name="ScanButton" Content="Analisar agora" l:Tr.Key="analisar_agora"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Margin="0,26,0,0"
                            Click="Scan_Click" />

                    <ProgressBar x:Name="ScanProgress" Height="4"
                                 Background="{StaticResource PanelAlt}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="0,22,0,0"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="ScanProgressText" FontSize="12"
                               Foreground="{StaticResource Dim}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CancelButton" Content="Cancelar" l:Tr.Key="cancelar"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0" Padding="14,7" FontSize="12.5"
                            Visibility="Collapsed"
                            Click="Cancel_Click" />
                </StackPanel>
            </Border>

            <!-- Lista -->
            <Border x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="SelectAllCheck"
                                      Style="{StaticResource RowCheck}"
                                      Checked="SelectAllCheck_Changed"
                                      Unchecked="SelectAllCheck_Changed" />
                            <TextBlock Grid.Column="1" Text="ITEM" l:Tr.Key="item" FontSize="10.5"
                                       Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="TAMANHO" l:Tr.Key="tamanho" FontSize="10.5"
                                       Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="RISCO" l:Tr.Key="risco" FontSize="10.5"
                                       Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- ListBox virtualizante: mesmas linhas, mas só as visíveis são realizadas. -->
                    <ListBox Grid.Row="1" x:Name="ItemsList"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,4"
                             SelectionMode="Single"
                             IsSynchronizedWithCurrentItem="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <!-- Zera o visual do ListBoxItem: sem hover/seleção/foco, idêntico ao ItemsControl. -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="UseLayoutRounding" Value="True" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}" />

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0" />

                                                <!-- Prévia do conteúdo -->
                                                <Border x:Name="PreviewBox"
                                                        Background="{StaticResource BgDeep}"
                                                        BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="11,9" Margin="0,9,0,0"
                                                        Visibility="{Binding PreviewVisibility}">
                                                    <ItemsControl ItemsSource="{Binding Preview}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                                                           FontSize="11.5"
                                                                           Foreground="{StaticResource MonoText}"
                                                                           TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource Fg}"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,12,0" />

                                            <Border Grid.Column="3" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right"
                                                    Background="{Binding RiskBackground}"
                                                    CornerRadius="9" Padding="10,4"
                                                    Margin="0,1,0,0">
                                                <TextBlock Text="{Binding RiskLabel}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding RiskForeground}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Otimização -->
            <Border x:Name="OptimizePanel" Grid.Row="1" Visibility="Collapsed"
                    Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="18,16">
                    <StackPanel>

                        <!-- Aceleração em 1 clique -->
                        <Border Style="{StaticResource CardAlt}">
                            <StackPanel>
                                <TextBlock Text="Aceleração em 1 clique" l:Tr.Key="aceleracao_em_1_clique"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Libera a memória dos processos em uso e limpa o cache DNS do Windows de uma vez." l:Tr.Key="libera_a_memoria_dos_processos_em_uso_e_limpa_o"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button x:Name="BoostButton" Content="Acelerar agora" l:Tr.Key="acelerar_agora"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Click="Boost_Click" />
                                <TextBlock x:Name="BoostStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Componentes do Windows (WinSxS) -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Componentes do Windows (WinSxS)" l:Tr.Key="componentes_do_windows_winsxs"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Remove versões antigas de componentes do Windows já substituídas por atualizações. Pode liberar vários GB. Exige administrador." l:Tr.Key="remove_versoes_antigas_de_componentes_do_windows"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <CheckBox x:Name="WinSxSDeepCheck" Content="Limpeza profunda (remove também a base de rollback — irreversível)" l:Tr.Key="limpeza_profunda_remove_tambem_a_base_de_rollbac"
                                          FontSize="12" Foreground="{StaticResource Dim}"
                                          Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="WinSxSCleanButton" Content="Limpar componentes" l:Tr.Key="limpar_componentes"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="WinSxS_Clean_Click" />
                                    <Button x:Name="WinSxSCancelButton" Content="Cancelar" l:Tr.Key="cancelar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Margin="10,0,0,0"
                                            Visibility="Collapsed"
                                            Click="WinSxS_Cancel_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="WinSxSProgress" Height="4" Margin="0,10,0,0"
                                             IsIndeterminate="True" Visibility="Collapsed"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" />
                                <TextBlock x:Name="WinSxSStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Security Reinforce -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Reforço de segurança" l:Tr.Key="reforco_de_seguranca"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Desabilita autorun, compartilhamentos administrativos ocultos, NTLMv1 e WDigest em texto claro. Reduz a superfície de ataque." l:Tr.Key="desabilita_autorun_compartilhamentos_administrat"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <CheckBox x:Name="ReinforceDeepCheck" Content="Reforço profundo (desabilita Remote Registry e SMBv1)" l:Tr.Key="reforco_profundo_desabilita_remote_registry_e_sm"
                                          FontSize="12" Foreground="{StaticResource Dim}"
                                          Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="ReinforceButton" Content="Aplicar reforço" l:Tr.Key="aplicar_reforco"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="Reinforce_Click" />
                                    <TextBlock x:Name="ReinforceStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Driver Cleaner -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Limpeza de drivers antigos" l:Tr.Key="limpeza_de_drivers_antigos"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Remove versões antigas de drivers no DriverStore, mantendo a mais recente de cada fornecedor. Requer administrador." l:Tr.Key="remove_versoes_antigas_de_drivers_no_driverstore"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="DriverCleanButton" Content="Limpar drivers antigos" l:Tr.Key="limpar_drivers_antigos"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="DriverClean_Click" />
                                    <TextBlock x:Name="DriverCleanStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Settings -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Configurações rápidas" l:Tr.Key="configuracoes_rapidas"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Ajustes de UX e desempenho do Windows." l:Tr.Key="ajustes_de_ux_e_desempenho_do_windows"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <CheckBox x:Name="QsShowExtensions" Content="Mostrar extensões de arquivo" l:Tr.Key="mostrar_extensoes_de_arquivo"
                                          FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" IsChecked="True" />
                                <CheckBox x:Name="QsShowHidden" Content="Mostrar arquivos ocultos" l:Tr.Key="mostrar_arquivos_ocultos"
                                          FontSize="12" Foreground="{StaticResource Dim}" Margin="0,4,0,0" />
                                <CheckBox x:Name="QsDarkMode" Content="Modo escuro do Windows" l:Tr.Key="modo_escuro_do_windows"
                                          FontSize="12" Foreground="{StaticResource Dim}" Margin="0,4,0,0" />
                                <CheckBox x:Name="QsDisableAnimations" Content="Desabilitar animações (desempenho)" l:Tr.Key="desabilitar_animacoes_desempenho"
                                          FontSize="12" Foreground="{StaticResource Dim}" Margin="0,4,0,0" />
                                <CheckBox x:Name="QsDisableTransparency" Content="Desabilitar transparência" l:Tr.Key="desabilitar_transparencia"
                                          FontSize="12" Foreground="{StaticResource Dim}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="QuickSettingsButton" Content="Aplicar" l:Tr.Key="aplicar"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="QuickSettings_Click" />
                                    <TextBlock x:Name="QuickSettingsStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Auto RAM Clean -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Auto RAM Clean" l:Tr.Key="auto_ram_clean"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Limpa a RAM automaticamente a cada intervalo (enquanto o app estiver aberto)." l:Tr.Key="limpa_a_ram_automaticamente_a_cada_intervalo_enq"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="AutoRamEnabled" Content="Habilitar" l:Tr.Key="habilitar"
                                              FontSize="12" Foreground="{StaticResource Dim}"
                                              VerticalAlignment="Center"
                                              Checked="AutoRam_Toggle" Unchecked="AutoRam_Toggle" />
                                    <TextBlock Text="Intervalo (min):" l:Tr.Key="intervalo_min" FontSize="12"
                                               Foreground="{StaticResource Dim}"
                                               Margin="16,0,6,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="AutoRamInterval" Text="10" l:Tr.Key="10" Width="50"
                                             FontSize="12" Padding="4,2" />
                                </StackPanel>
                                    <TextBlock x:Name="AutoRamStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- AutoClean agendado -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Limpeza automática (agendada)" l:Tr.Key="limpeza_automatica_agendada"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Cria uma tarefa agendada do Windows que executa a limpeza em segundo plano." l:Tr.Key="cria_uma_tarefa_agendada_do_windows_que_executa"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Intervalo (min):" l:Tr.Key="intervalo_min" FontSize="12"
                                               Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="AutoCleanInterval" Text="60" l:Tr.Key="60" Width="60"
                                             FontSize="12" Padding="4,2" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="AutoCleanScheduleButton" Content="Agendar" l:Tr.Key="agendar"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="AutoCleanSchedule_Click" />
                                    <Button x:Name="AutoCleanUnscheduleButton" Content="Cancelar agendamento" l:Tr.Key="cancelar_agendamento"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Margin="10,0,0,0"
                                            Click="AutoCleanUnschedule_Click" />
                                    <TextBlock x:Name="AutoCleanStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Registry Clean (seguro) -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Limpeza de registro (segura)" l:Tr.Key="limpeza_de_registro_segura"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Remove entradas órfãs de software desinstalado e rastros de arquivos recentes (MRU). Faz backup antes de remover." l:Tr.Key="remove_entradas_orfas_de_software_desinstalado_e"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="RegistryCleanButton" Content="Limpar registro" l:Tr.Key="limpar_registro"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="RegistryClean_Click" />
                                    <TextBlock x:Name="RegistryCleanStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Safe Folder -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Pasta segura (Safe Folder)" l:Tr.Key="pasta_segura_safe_folder"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Cria uma pasta com ACLs restritivas: apenas o usuário atual tem acesso. Protege dados sensíveis contra outros usuários/processos." l:Tr.Key="cria_uma_pasta_com_acls_restritivas_apenas_o_usu"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="SafeFolderButton" Content="Criar / Abrir pasta segura" l:Tr.Key="criar_abrir_pasta_segura"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="SafeFolder_Click" />
                                    <TextBlock x:Name="SafeFolderStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Registry Defrag (somente medição — a substituição agendada do hive no boot foi removida: podia corromper o perfil) -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Desfragmentação do registro (informativo)" l:Tr.Key="desfragmentacao_do_registro_informativo"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Mede o tamanho do hive do usuário. A compactação real do registro requer ferramentas offline e reinicialização; use a limpeza de registro acima para reduzir o tamanho." l:Tr.Key="mede_o_tamanho_do_hive_do_usuario_a_compactacao"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="RegDefragButton" Content="Medir hive" l:Tr.Key="medir_hive"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="RegDefrag_Click" />
                                    <TextBlock x:Name="RegDefragStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Destruição segura de arquivo -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Destruição segura de arquivo" l:Tr.Key="destruicao_segura_de_arquivo"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Sobrescreve o arquivo 3 vezes (DoD 5220.22-M) antes de apagar, dificultando a recuperação. Escolha o arquivo." l:Tr.Key="sobrescreve_o_arquivo_3_vezes_dod_5220_22_m_ante"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="SecureDeleteButton" Content="Escolher e destruir…" l:Tr.Key="escolher_e_destruir"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" FontSize="12.5"
                                            Click="SecureDelete_Click" />
                                    <TextBlock x:Name="SecureDeleteStatus" FontSize="12.5"
                                               Foreground="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Uso do sistema -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Uso do sistema" l:Tr.Key="uso_do_sistema"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Atualizado a cada segundo (últimos 60 s)." l:Tr.Key="atualizado_a_cada_segundo_ultimos_60_s"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU -->
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock x:Name="MonitorCpuText" Text="CPU: —"
                                                   FontSize="12.5" Foreground="{StaticResource Fg}" />
                                        <ProgressBar x:Name="MonitorCpuBar" Maximum="100" Height="6"
                                                     Background="{StaticResource Bg}"
                                                     Foreground="{StaticResource Accent}"
                                                     BorderThickness="0" Margin="0,8,0,0" />
                                        <Grid x:Name="MonitorCpuChart" Height="32" Margin="0,8,0,0"
                                              Background="{StaticResource BgDeep}"
                                              ClipToBounds="True">
                                            <Polygon x:Name="MonitorCpuArea"
                                                     Fill="{StaticResource SparkCpuFill}"
                                                     IsHitTestVisible="False" />
                                            <Polyline x:Name="MonitorCpuLine"
                                                      Stroke="{StaticResource Accent}"
                                                      StrokeThickness="1.5"
                                                      IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Memória -->
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock x:Name="MonitorMemText" Text="Memória: —"
                                                   FontSize="12.5" Foreground="{StaticResource Fg}" />
                                        <ProgressBar x:Name="MonitorMemBar" Maximum="100" Height="6"
                                                     Background="{StaticResource Bg}"
                                                     Foreground="{StaticResource Accent}"
                                                     BorderThickness="0" Margin="0,8,0,0" />
                                        <Grid x:Name="MonitorMemChart" Height="32" Margin="0,8,0,0"
                                              Background="{StaticResource BgDeep}"
                                              ClipToBounds="True">
                                            <Polygon x:Name="MonitorMemArea"
                                                     Fill="{StaticResource SparkMemFill}"
                                                     IsHitTestVisible="False" />
                                            <Polyline x:Name="MonitorMemLine"
                                                      Stroke="{StaticResource Dim}"
                                                      StrokeThickness="1.5"
                                                      IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lixeira -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Lixeira" l:Tr.Key="lixeira"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="BinStatusText"
                                               Text="—"
                                               FontSize="12.5" Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0" />

                                    <Button Grid.Column="1" x:Name="BinRefreshButton"
                                            Content="Verificar" l:Tr.Key="verificar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Click="BinRefresh_Click" />

                                    <Button Grid.Column="2" x:Name="BinEmptyButton"
                                            Content="Esvaziar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Margin="10,0,0,0"
                                            Click="BinEmpty_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Inicialização -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Inicialização" l:Tr.Key="inicializacao"
                                               FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Fg}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="StartupRefreshButton"
                                            Content="Atualizar" l:Tr.Key="atualizar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12"
                                            Click="StartupRefresh_Click" />
                                </Grid>
                                <TextBlock
                                    Text="Programas que sobem com o Windows, vindos das chaves Run e das pastas Inicializar. Desativar não apaga nada — dá para ativar de volta depois." l:Tr.Key="programas_que_sobem_com_o_windows_vindos_das_cha"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="StartupMessage" FontSize="12"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />

                                <ListBox x:Name="StartupList" Margin="0,12,0,0" MaxHeight="320"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0"
                                         SelectionMode="Single"
                                         IsSynchronizedWithCurrentItem="False"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Focusable="False">
                                    <ListBox.ItemContainerStyle>
                                        <!-- Segundo container inline: mesmo reset do ItemsList,
                                             sem tocar no estilo existente. -->
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="UseLayoutRounding" Value="True" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,12" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="0,0,0,1"
                                                    Opacity="{Binding RowOpacity}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="28" Height="28"
                                                            CornerRadius="9" VerticalAlignment="Center"
                                                            Background="{StaticResource BgDeep}"
                                                            BorderBrush="{StaticResource Line}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="⚙" FontSize="13"
                                                                   Foreground="{StaticResource Accent}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontSize="13.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Fg}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1"
                                                                    Background="{StaticResource WarnPanel}" CornerRadius="9"
                                                                    Padding="10,4" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding DisabledBadgeVisibility}">
                                                                <TextBlock Text="Desativado" l:Tr.Key="desativado" FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource WarnText}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding SourceLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Command}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="{Binding ActionLabel}"
                                                            Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="12,6" FontSize="12"
                                                            VerticalAlignment="Center"
                                                            IsEnabled="{Binding ActionEnabled}"
                                                            ToolTip="{Binding ActionToolTip}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Click="StartupToggle_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Memória RAM -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Memória RAM" l:Tr.Key="memoria_ram"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Esvazia o working set dos processos maiores: o Windows devolve à memória física as páginas que não estão em uso. Os programas continuam abertos." l:Tr.Key="esvazia_o_working_set_dos_processos_maiores_o_wi"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button x:Name="TrimButton" Content="Liberar memória agora" l:Tr.Key="liberar_memoria_agora"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Click="Trim_Click" />
                                <ProgressBar x:Name="TrimProgress" Height="4"
                                             IsIndeterminate="True"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" Margin="0,14,0,0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="TrimResult" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Sistema e Rede -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Sistema e Rede" l:Tr.Key="sistema_e_rede"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Diagnóstico do último boot e o cache de nomes do Windows." l:Tr.Key="diagnostico_do_ultimo_boot_e_o_cache_de_nomes_do"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="BootTimeText"
                                           Text="Última inicialização: carregando…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock x:Name="BootHistoryText"
                                           Text="Histórico: carregando…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button x:Name="DnsButton" Content="Limpar cache DNS" l:Tr.Key="limpar_cache_dns"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Padding="14,7" FontSize="12.5"
                                        Click="Dns_Click" />
                                <TextBlock x:Name="DnsMessage" FontSize="12"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Rede -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Rede" l:Tr.Key="rede"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Adaptadores de rede do Windows. Renovar o endereço IP e limpar o cache ARP exigem administrador." l:Tr.Key="adaptadores_de_rede_do_windows_renovar_o_enderec"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />

                                <ItemsControl x:Name="NetList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,8" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Fg}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="11.5" Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Ipv4}"
                                                               FontSize="12" Foreground="{StaticResource Dim}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="NetRefreshButton" Content="Atualizar" l:Tr.Key="atualizar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Click="NetRefresh_Click" />
                                    <Button x:Name="NetRenewButton" Content="Renovar endereço IP" l:Tr.Key="renovar_endereco_ip"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5" Margin="10,0,0,0"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="NetRenew_Click" />
                                    <Button x:Name="NetArpButton" Content="Limpar cache ARP" l:Tr.Key="limpar_cache_arp"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5" Margin="10,0,0,0"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="NetArp_Click" />
                                </StackPanel>

                                <TextBlock x:Name="NetStatus" FontSize="12"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Disco do sistema -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Disco do sistema" l:Tr.Key="disco_do_sistema"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Otimização do disco que contém o Windows: TRIM em SSD, desfragmentação em HDD. Pode levar alguns minutos." l:Tr.Key="otimizacao_do_disco_que_contem_o_windows_trim_em"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="DiskMediaTypeText"
                                           Text="Tipo de disco: verificando…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <Button x:Name="OptimizeDiskButton" Content="Otimizar disco (C:)" l:Tr.Key="otimizar_disco_c"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="OptimizeDisk_Click" />
                                <ProgressBar x:Name="DiskProgress" Height="4"
                                             IsIndeterminate="True"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" Margin="0,14,0,0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="DiskStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                                <Button x:Name="DiskCancelButton" Content="Cancelar" l:Tr.Key="cancelar"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="14,7" FontSize="12.5"
                                        Visibility="Collapsed"
                                        Click="DiskCancel_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Saúde do disco -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Saúde do disco" l:Tr.Key="saude_do_disco"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Estado dos discos físicos (SMART) e verificação online do volume do sistema com chkdsk /scan." l:Tr.Key="estado_dos_discos_fisicos_smart_e_verificacao_on"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="DiskHealthText"
                                           Text="Verificando discos…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="DiskHealthRefreshButton" Content="Verificar saúde" l:Tr.Key="verificar_saude"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Click="DiskHealthRefresh_Click" />
                                    <Button x:Name="DiskScanButton" Content="Verificar volume (chkdsk /scan)" l:Tr.Key="verificar_volume_chkdsk_scan"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,7" FontSize="12.5" Margin="10,0,0,0"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="DiskScan_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="DiskScanProgress" Height="4"
                                             IsIndeterminate="True"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" Margin="0,14,0,0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="DiskScanStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                                <Button x:Name="DiskScanCancelButton" Content="Cancelar" l:Tr.Key="cancelar"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="14,7" FontSize="12.5"
                                        Visibility="Collapsed"
                                        Click="DiskScanCancel_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Relatório de energia -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Relatório de energia" l:Tr.Key="relatorio_de_energia"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Relatórios de consumo (powercfg /energy, 60 s) e da bateria, salvos como HTML." l:Tr.Key="relatorios_de_consumo_e_bateria_html"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="PowerEnergyButton" Content="Gerar relatório de energia (60 s)" l:Tr.Key="gerar_relatorio_de_energia_60_s"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,7" FontSize="12.5"
                                            ToolTip="Exige administrador" l:Tr.TipKey="exige_administrador"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="PowerEnergy_Click" />
                                    <Button x:Name="PowerBatteryButton" Content="Relatório de bateria" l:Tr.Key="relatorio_de_bateria"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5" Margin="10,0,0,0"
                                            Click="PowerBattery_Click" />
                                    <Button x:Name="PowerOpenFolderButton" Content="Abrir pasta dos relatórios" l:Tr.Key="abrir_pasta_dos_relatorios"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5" Margin="10,0,0,0"
                                            Click="PowerOpenFolder_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="PowerProgress" Height="4"
                                             IsIndeterminate="True"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" Margin="0,14,0,0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="PowerStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                                <Button x:Name="PowerCancelButton" Content="Cancelar" l:Tr.Key="cancelar"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="14,7" FontSize="12.5"
                                        Visibility="Collapsed"
                                        Click="PowerCancel_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Processos -->
                        <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Processos" l:Tr.Key="processos"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Maiores consumidores de memória. Encerre o que não estiver usando." l:Tr.Key="maiores_consumidores_de_memoria_encerre_o_que_na"
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="ProcStatusText"
                                               FontSize="11.5" Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0" />
                                    <Button Grid.Column="1" x:Name="ProcRefreshButton"
                                            Content="Atualizar" l:Tr.Key="atualizar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12"
                                            Click="ProcRefresh_Click" />
                                </Grid>

                                <ListBox x:Name="ProcList" Margin="0,12,0,0" MaxHeight="320"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0"
                                         SelectionMode="Single"
                                         IsSynchronizedWithCurrentItem="False"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Focusable="False">
                                    <ListBox.ItemContainerStyle>
                                        <!-- Mesmo reset inline das demais listas. -->
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="UseLayoutRounding" Value="True" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,12" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Fg}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PidLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding MemoryDisplay}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource Fg}"
                                                               MinWidth="90"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,14,0" />

                                                    <Button Grid.Column="2"
                                                            Content="{Binding ActionLabel}"
                                                            Tag="{Binding Pid}"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="12,6" FontSize="12"
                                                            VerticalAlignment="Center"
                                                            Click="ProcEnd_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Duplicados -->
            <Border x:Name="DuplicatesPanel" Grid.Row="1" Visibility="Collapsed"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="DuplicatesPathBox"
                                     IsReadOnly="True"
                                     Background="{StaticResource Bg}"
                                     Foreground="{StaticResource Fg}"
                                     BorderBrush="{StaticResource Line}"
                                     BorderThickness="1" Padding="10,8"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <Button Grid.Column="1" x:Name="DuplicatesBrowseButton"
                                    Content="Escolher pasta…" l:Tr.Key="escolher_pasta"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    Click="DuplicatesBrowse_Click" />

                            <Button Grid.Column="2" x:Name="DuplicatesScanButton"
                                    Content="Procurar duplicados" l:Tr.Key="procurar_duplicados"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    IsEnabled="False"
                                    Click="DuplicatesScan_Click" />

                            <Button Grid.Column="3" x:Name="DuplicatesCancelButton"
                                    Content="Cancelar" l:Tr.Key="cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="DuplicatesCancel_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <StackPanel Grid.Row="1" x:Name="DuplicatesProgressPanel"
                                Visibility="Collapsed" Margin="18,14,18,0">
                        <ProgressBar x:Name="DuplicatesProgress" Height="4"
                                     IsIndeterminate="True"
                                     Background="{StaticResource Bg}"
                                     Foreground="{StaticResource Accent}"
                                     BorderThickness="0" />
                        <TextBlock x:Name="DuplicatesProgressText" FontSize="12"
                                   Foreground="{StaticResource Dim}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="DuplicatesEmptyState"
                                   Text="Escolha uma pasta para procurar arquivos duplicados."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="DuplicatesList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline do StartupList/ItemsList. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Fg}"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="96" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      Style="{StaticResource RowCheck}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FilePath}"
                                                                       FontSize="12.5"
                                                                       Foreground="{StaticResource Fg}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FilePath}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DateDisplay}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource Dim}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding SizeDisplay}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource Fg}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="DuplicatesSummary"
                                       FontSize="12.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />

                            <Button Grid.Column="1" x:Name="DuplicatesRecycleButton"
                                    Content="Reciclar selecionados (0)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="DuplicatesRecycle_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Atalhos -->
            <Border x:Name="ShortcutsPanel" Grid.Row="1" Visibility="Collapsed"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="ShortcutsStatusText"
                                       FontSize="12" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />

                            <Button Grid.Column="1" x:Name="ShortcutsCancelButton"
                                    Content="Cancelar" l:Tr.Key="cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed"
                                    Click="ShortcutsCancel_Click" />

                            <Button Grid.Column="2" x:Name="ShortcutsScanButton"
                                    Content="Procurar atalhos quebrados" l:Tr.Key="procurar_atalhos_quebrados"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Click="ShortcutsScan_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <ProgressBar Grid.Row="1" x:Name="ShortcutsProgress" Height="4"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="{StaticResource Bg}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="18,14,18,0" />

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ShortcutsEmptyState"
                                   Text="Clique em Procurar atalhos quebrados."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="ShortcutsList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline do DuplicatesList/StartupList. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LocationLabel}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding TargetLabel}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="ShortcutsSummary"
                                       FontSize="12.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />

                            <Button Grid.Column="1" x:Name="ShortcutsRecycleButton"
                                    Content="Remover selecionados (0)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="ShortcutsRecycle_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Aplicativos -->
            <Grid x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />      <!-- atualizações -->
                    <RowDefinition Height="Auto" />   <!-- desinstalação -->
                </Grid.RowDefinitions>

                <!-- Atualizações -->
                <Border Grid.Row="0"
                        Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="AppsStatusText"
                                       FontSize="12" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />

                            <Button Grid.Column="1" x:Name="AppsExportButton"
                                    Content="Exportar lista" l:Tr.Key="exportar_lista"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="0,0,10,0"
                                    ToolTip="Salva a lista de programas instalados em um arquivo JSON." l:Tr.TipKey="exporta_a_lista_de_programas_instalados_em_json"
                                    ToolTipService.ShowOnDisabled="True"
                                    IsEnabled="False"
                                    Click="AppsExport_Click" />

                            <Button Grid.Column="2" x:Name="AppsImportButton"
                                    Content="Importar lista" l:Tr.Key="importar_lista"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="0,0,10,0"
                                    ToolTip="Instala os programas de um arquivo de backup." l:Tr.TipKey="instala_os_programas_de_um_arquivo_de_backup"
                                    ToolTipService.ShowOnDisabled="True"
                                    IsEnabled="False"
                                    Click="AppsImport_Click" />

                            <Button Grid.Column="3" x:Name="AppsCancelButton"
                                    Content="Cancelar" l:Tr.Key="cancelar"
                                    Style="{StaticResource GhostButton}"
