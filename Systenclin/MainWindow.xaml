                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
