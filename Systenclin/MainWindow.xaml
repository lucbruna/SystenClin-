                        <TextBlock x:Name="SpaceSummary"
                                   FontSize="12.5" Foreground="{StaticResource Dim}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Barra de status -->
            <Border Grid.Row="2" x:Name="StatusBar" Visibility="Collapsed"
                    Style="{StaticResource Card}" Padding="18,13" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ctl:CircularGauge x:Name="SelectionGauge" Width="52" Height="52"
                                           Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SelectionSummary" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                            <TextBlock x:Name="SelectionNote" FontSize="12"
                                       Foreground="{StaticResource Dim}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="RestorePointCheck"
                                  Content="Criar ponto de restauração antes de limpar" l:Tr.Key="criar_ponto_de_restauracao_antes_de_limpar"
                                  Foreground="{StaticResource Dim}" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Cursor="Hand"
                                  ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="RescanButton" Content="Analisar de novo" l:Tr.Key="analisar_de_novo"
                                Style="{StaticResource GhostButton}"
                                Click="Rescan_Click" Margin="0,0,10,0" />
                        <Button x:Name="CleanButton" Content="Limpar selecionados" l:Tr.Key="limpar_selecionados"
                                Style="{StaticResource PrimaryButton}"
                                Click="Clean_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ Rodapé ══════════════ -->
        <Border Grid.Row="3" Padding="28,10,28,12" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Background="{StaticResource Panel}">
            <StackPanel>
                <!-- Faixa de pipeline: o fluxo real do app -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,9">
                    <Border Background="{StaticResource TabActiveBg}"
                            BorderBrush="{StaticResource NeonLine}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <TextBlock Text="ANALISAR" l:Tr.Key="wf_analisar" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Text="→" FontSize="11" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" Margin="8,0" />
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <TextBlock Text="REVISAR" l:Tr.Key="wf_revisar" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
                    </Border>
                    <TextBlock Text="→" FontSize="11" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" Margin="8,0" />
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <TextBlock Text="LIMPAR" l:Tr.Key="wf_limpar" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
                    </Border>
                    <TextBlock Text="→" FontSize="11" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" Margin="8,0" />
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <TextBlock Text="RECUPERAR" l:Tr.Key="wf_recuperar" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
                    </Border>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterText"
                           FontSize="11.5" Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Systenclin 0.13 — arquivos vão para a Lixeira; dados de navegador têm backup automático." l:Tr.Key="systenclin_0_8_arquivos_vao_para_a_lixeira_dados" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <TextBlock x:Name="FooterCpuText" Text="CPU —"
                               FontSize="11.5" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="11.5"
                               Foreground="{StaticResource Dim}"
                               Margin="7,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterMemText" Text="RAM —"
                               FontSize="11.5" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <RadioButton x:Name="LangPt" Content="PT" GroupName="Lang"
                                 Tag="pt-BR" Checked="Lang_Checked"
                                 Style="{StaticResource LangButton}"
                                 Margin="0,0,2,0" VerticalAlignment="Center"
                                 ToolTip="Português" />
                    <RadioButton x:Name="LangEn" Content="EN" GroupName="Lang"
                                 Tag="en" Checked="Lang_Checked"
                                 Style="{StaticResource LangButton}"
                                 Margin="0,0,2,0" VerticalAlignment="Center"
                                 ToolTip="English" />
                    <RadioButton x:Name="LangEs" Content="ES" GroupName="Lang"
                                 Tag="es" Checked="Lang_Checked"
                                 Style="{StaticResource LangButton}"
                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                 ToolTip="Español" />
                    <Button x:Name="BackupsButton" Content="Backups" l:Tr.Key="backups"
                            Style="{StaticResource GhostButton}"
                            Padding="12,6" FontSize="12"
                            Click="Backups_Click" Margin="0,0,8,0" />
                    <Button x:Name="HistoryButton" Content="Histórico" l:Tr.Key="historico"
                            Style="{StaticResource GhostButton}"
                            Padding="12,6" FontSize="12"
                            Click="History_Click" />
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
