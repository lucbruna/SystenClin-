<Window x:Class="Systenclin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Systenclin"
        Height="780" Width="1140"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- cabeçalho -->
            <RowDefinition Height="Auto" />   <!-- abas -->
            <RowDefinition Height="*" />      <!-- conteúdo -->
            <RowDefinition Height="Auto" />   <!-- rodapé -->
        </Grid.RowDefinitions>

        <!-- ══════════════ Cabeçalho ══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderTitle" Text="Limpeza de arquivos temporários"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Nada foi apagado ainda. Clique em Analisar para ver o que dá para liberar."
                               FontSize="12.5" Foreground="{StaticResource Dim}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="FreeSpaceText" FontSize="12.5"
                           Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
            </Grid>
        </Border>

        <!-- ══════════════ Abas ══════════════ -->
        <Border Grid.Row="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <RadioButton x:Name="TabFiles" Style="{StaticResource TabButton}"
                             GroupName="Tabs" IsChecked="True"
                             Checked="Tab_Changed" Tag="files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Arquivos" FontSize="13.5" />
                        <Border x:Name="FilesBadge" Background="{StaticResource Accent}"
                                CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="FilesBadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#0B0F14" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabPrivacy" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="privacy">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Privacidade" FontSize="13.5" />
                        <Border x:Name="PrivacyBadge" Background="{StaticResource Accent}"
                                CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="PrivacyBadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#0B0F14" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabOptimize" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="optimize">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Otimização" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabDuplicates" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="duplicates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Duplicados" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabShortcuts" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Atalhos" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabApps" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="apps">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Aplicativos" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabLargeFiles" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="largefiles">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Arquivos grandes" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabSpace" Style="{StaticResource TabButton}"
                             GroupName="Tabs" Checked="Tab_Changed" Tag="space">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Espaço" FontSize="13.5" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ══════════════ Conteúdo ══════════════ -->
        <Grid Grid.Row="2" Margin="28,20,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- aviso de navegador aberto -->
                <RowDefinition Height="*" />      <!-- lista -->
                <RowDefinition Height="Auto" />   <!-- barra de status -->
            </Grid.RowDefinitions>

            <!-- Aviso: navegadores abertos -->
            <Border Grid.Row="0" x:Name="BrowserWarning" Visibility="Collapsed"
                    Background="#3A3012" BorderBrush="#7A5C14" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="18"
                               Foreground="{StaticResource Warn}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="BrowserWarningTitle" FontSize="13.5"
                                   FontWeight="SemiBold" Foreground="#F0C674" />
                        <TextBlock x:Name="BrowserWarningBody" FontSize="12.5"
                                   Foreground="#D9C08A" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado vazio / varrendo -->
            <Border x:Name="EmptyState" Grid.Row="1"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="560">
                    <TextBlock x:Name="EmptyIcon" Text="🔍" FontSize="46"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock x:Name="EmptyTitle" Text="Pronto para analisar"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody"
                               Text="A análise só lê o disco: mede o tamanho das pastas de cache e lista o que pode ser liberado. Nenhum arquivo é tocado até você confirmar."
                               FontSize="13.5" Foreground="{StaticResource Dim}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0" />

                    <!-- O botão de analisar fica SEMPRE visível: é a única porta
                         de entrada do app. Sem ele no estado vazio, não há como
                         começar. -->
                    <Button x:Name="ScanButton" Content="Analisar agora"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Margin="0,26,0,0"
                            Click="Scan_Click" />

                    <ProgressBar x:Name="ScanProgress" Height="4"
                                 Background="{StaticResource PanelAlt}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="0,22,0,0"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="ScanProgressText" FontSize="12"
                               Foreground="{StaticResource Dim}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CancelButton" Content="Cancelar"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0" Padding="14,7" FontSize="12.5"
                            Visibility="Collapsed"
                            Click="Cancel_Click" />
                </StackPanel>
            </Border>

            <!-- Lista -->
            <Border x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="SelectAllCheck"
                                      Style="{StaticResource RowCheck}"
                                      Checked="SelectAllCheck_Changed"
                                      Unchecked="SelectAllCheck_Changed" />
                            <TextBlock Grid.Column="1" Text="ITEM" FontSize="10.5"
                                       Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="TAMANHO" FontSize="10.5"
                                       Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="RISCO" FontSize="10.5"
                                       Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- ListBox virtualizante: mesmas linhas, mas só as visíveis são realizadas. -->
                    <ListBox Grid.Row="1" x:Name="ItemsList"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,4"
                             SelectionMode="Single"
                             IsSynchronizedWithCurrentItem="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <!-- Zera o visual do ListBoxItem: sem hover/seleção/foco, idêntico ao ItemsControl. -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="UseLayoutRounding" Value="True" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}" />

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0" />

                                                <!-- Prévia do conteúdo -->
                                                <Border x:Name="PreviewBox"
                                                        Background="#0B0F14"
                                                        BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="11,9" Margin="0,9,0,0"
                                                        Visibility="{Binding PreviewVisibility}">
                                                    <ItemsControl ItemsSource="{Binding Preview}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                                                           FontSize="11.5"
                                                                           Foreground="#A5D6FF"
                                                                           TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource Fg}"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,12,0" />

                                            <Border Grid.Column="3" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right"
                                                    Background="{Binding RiskBackground}"
                                                    CornerRadius="4" Padding="8,3"
                                                    Margin="0,2,0,0">
                                                <TextBlock Text="{Binding RiskLabel}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding RiskForeground}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Otimização -->
            <Border x:Name="OptimizePanel" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="18,16">
                    <StackPanel>

                        <!-- Aceleração em 1 clique -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Aceleração em 1 clique"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Libera a memória dos processos em uso e limpa o cache DNS do Windows de uma vez."
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button x:Name="BoostButton" Content="Acelerar agora"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Click="Boost_Click" />
                                <TextBlock x:Name="BoostStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Uso do sistema -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Uso do sistema"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock Text="Atualizado a cada segundo (últimos 60 s)."
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU -->
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock x:Name="MonitorCpuText" Text="CPU: —"
                                                   FontSize="12.5" Foreground="{StaticResource Fg}" />
                                        <ProgressBar x:Name="MonitorCpuBar" Maximum="100" Height="6"
                                                     Background="{StaticResource Bg}"
                                                     Foreground="{StaticResource Accent}"
                                                     BorderThickness="0" Margin="0,8,0,0" />
                                        <Grid x:Name="MonitorCpuChart" Height="32" Margin="0,8,0,0"
                                              Background="{StaticResource Bg}"
                                              ClipToBounds="True">
                                            <Polyline x:Name="MonitorCpuLine"
                                                      Stroke="{StaticResource Accent}"
                                                      StrokeThickness="1.5"
                                                      IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Memória -->
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock x:Name="MonitorMemText" Text="Memória: —"
                                                   FontSize="12.5" Foreground="{StaticResource Fg}" />
                                        <ProgressBar x:Name="MonitorMemBar" Maximum="100" Height="6"
                                                     Background="{StaticResource Bg}"
                                                     Foreground="{StaticResource Accent}"
                                                     BorderThickness="0" Margin="0,8,0,0" />
                                        <Grid x:Name="MonitorMemChart" Height="32" Margin="0,8,0,0"
                                              Background="{StaticResource Bg}"
                                              ClipToBounds="True">
                                            <Polyline x:Name="MonitorMemLine"
                                                      Stroke="{StaticResource Dim}"
                                                      StrokeThickness="1.5"
                                                      IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lixeira -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Lixeira"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="BinStatusText"
                                               Text="—"
                                               FontSize="12.5" Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0" />

                                    <Button Grid.Column="1" x:Name="BinRefreshButton"
                                            Content="Verificar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Click="BinRefresh_Click" />

                                    <Button Grid.Column="2" x:Name="BinEmptyButton"
                                            Content="Esvaziar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="14,7" FontSize="12.5"
                                            Margin="10,0,0,0"
                                            Click="BinEmpty_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Inicialização -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Inicialização"
                                               FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Fg}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="StartupRefreshButton"
                                            Content="Atualizar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12"
                                            Click="StartupRefresh_Click" />
                                </Grid>
                                <TextBlock
                                    Text="Programas que sobem com o Windows, vindos das chaves Run e das pastas Inicializar. Desativar não apaga nada — dá para ativar de volta depois."
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="StartupMessage" FontSize="12"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />

                                <ListBox x:Name="StartupList" Margin="0,12,0,0" MaxHeight="320"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0"
                                         SelectionMode="Single"
                                         IsSynchronizedWithCurrentItem="False"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Focusable="False">
                                    <ListBox.ItemContainerStyle>
                                        <!-- Segundo container inline: mesmo reset do ItemsList,
                                             sem tocar no estilo existente. -->
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="UseLayoutRounding" Value="True" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,12" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="0,0,0,1"
                                                    Opacity="{Binding RowOpacity}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontSize="13.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Fg}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1"
                                                                    Background="#3A3012" CornerRadius="4"
                                                                    Padding="8,3" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding DisabledBadgeVisibility}">
                                                                <TextBlock Text="Desativado" FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#F0C674" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding SourceLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Command}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="{Binding ActionLabel}"
                                                            Tag="{Binding Id}"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="12,6" FontSize="12"
                                                            VerticalAlignment="Center"
                                                            IsEnabled="{Binding ActionEnabled}"
                                                            ToolTip="{Binding ActionToolTip}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Click="StartupToggle_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Memória RAM -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Memória RAM"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Esvazia o working set dos processos maiores: o Windows devolve à memória física as páginas que não estão em uso. Os programas continuam abertos."
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button x:Name="TrimButton" Content="Liberar memória agora"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Click="Trim_Click" />
                                <ProgressBar x:Name="TrimProgress" Height="4"
                                             IsIndeterminate="True"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" Margin="0,14,0,0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="TrimResult" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Sistema e Rede -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Sistema e Rede"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Diagnóstico do último boot e o cache de nomes do Windows."
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="BootTimeText"
                                           Text="Última inicialização: carregando…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock x:Name="BootHistoryText"
                                           Text="Histórico: carregando…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button x:Name="DnsButton" Content="Limpar cache DNS"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Padding="14,7" FontSize="12.5"
                                        Click="Dns_Click" />
                                <TextBlock x:Name="DnsMessage" FontSize="12"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Disco do sistema -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Disco do sistema"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Otimização do disco que contém o Windows: TRIM em SSD, desfragmentação em HDD. Pode levar alguns minutos."
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="DiskMediaTypeText"
                                           Text="Tipo de disco: verificando…"
                                           FontSize="12.5" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <Button x:Name="OptimizeDiskButton" Content="Otimizar disco (C:)"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="OptimizeDisk_Click" />
                                <ProgressBar x:Name="DiskProgress" Height="4"
                                             IsIndeterminate="True"
                                             Background="{StaticResource Bg}"
                                             Foreground="{StaticResource Accent}"
                                             BorderThickness="0" Margin="0,14,0,0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="DiskStatus" FontSize="12.5"
                                           Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="Collapsed" />
                                <Button x:Name="DiskCancelButton" Content="Cancelar"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Padding="14,7" FontSize="12.5"
                                        Visibility="Collapsed"
                                        Click="DiskCancel_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Processos -->
                        <Border Background="{StaticResource PanelAlt}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Processos"
                                           FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}" />
                                <TextBlock
                                    Text="Maiores consumidores de memória. Encerre o que não estiver usando."
                                    FontSize="12.5" Foreground="{StaticResource Dim}"
                                    TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="ProcStatusText"
                                               FontSize="11.5" Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0" />
                                    <Button Grid.Column="1" x:Name="ProcRefreshButton"
                                            Content="Atualizar"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12"
                                            Click="ProcRefresh_Click" />
                                </Grid>

                                <ListBox x:Name="ProcList" Margin="0,12,0,0" MaxHeight="320"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0"
                                         SelectionMode="Single"
                                         IsSynchronizedWithCurrentItem="False"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Focusable="False">
                                    <ListBox.ItemContainerStyle>
                                        <!-- Mesmo reset inline das demais listas. -->
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="UseLayoutRounding" Value="True" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,12" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Fg}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PidLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding MemoryDisplay}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource Fg}"
                                                               MinWidth="90"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,14,0" />

                                                    <Button Grid.Column="2"
                                                            Content="{Binding ActionLabel}"
                                                            Tag="{Binding Pid}"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="12,6" FontSize="12"
                                                            VerticalAlignment="Center"
                                                            Click="ProcEnd_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Duplicados -->
            <Border x:Name="DuplicatesPanel" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="DuplicatesPathBox"
                                     IsReadOnly="True"
                                     Background="{StaticResource Bg}"
                                     Foreground="{StaticResource Fg}"
                                     BorderBrush="{StaticResource Line}"
                                     BorderThickness="1" Padding="10,8"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <Button Grid.Column="1" x:Name="DuplicatesBrowseButton"
                                    Content="Escolher pasta…"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    Click="DuplicatesBrowse_Click" />

                            <Button Grid.Column="2" x:Name="DuplicatesScanButton"
                                    Content="Procurar duplicados"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    IsEnabled="False"
                                    Click="DuplicatesScan_Click" />

                            <Button Grid.Column="3" x:Name="DuplicatesCancelButton"
                                    Content="Cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="DuplicatesCancel_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <StackPanel Grid.Row="1" x:Name="DuplicatesProgressPanel"
                                Visibility="Collapsed" Margin="18,14,18,0">
                        <ProgressBar x:Name="DuplicatesProgress" Height="4"
                                     IsIndeterminate="True"
                                     Background="{StaticResource Bg}"
                                     Foreground="{StaticResource Accent}"
                                     BorderThickness="0" />
                        <TextBlock x:Name="DuplicatesProgressText" FontSize="12"
                                   Foreground="{StaticResource Dim}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="DuplicatesEmptyState"
                                   Text="Escolha uma pasta para procurar arquivos duplicados."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="DuplicatesList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline do StartupList/ItemsList. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Fg}"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="96" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      Style="{StaticResource RowCheck}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FilePath}"
                                                                       FontSize="12.5"
                                                                       Foreground="{StaticResource Fg}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FilePath}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DateDisplay}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource Dim}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding SizeDisplay}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource Fg}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="DuplicatesSummary"
                                       FontSize="12.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />

                            <Button Grid.Column="1" x:Name="DuplicatesRecycleButton"
                                    Content="Reciclar selecionados (0)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="DuplicatesRecycle_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Atalhos -->
            <Border x:Name="ShortcutsPanel" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="ShortcutsStatusText"
                                       FontSize="12" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />

                            <Button Grid.Column="1" x:Name="ShortcutsCancelButton"
                                    Content="Cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed"
                                    Click="ShortcutsCancel_Click" />

                            <Button Grid.Column="2" x:Name="ShortcutsScanButton"
                                    Content="Procurar atalhos quebrados"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Click="ShortcutsScan_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <ProgressBar Grid.Row="1" x:Name="ShortcutsProgress" Height="4"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="{StaticResource Bg}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="18,14,18,0" />

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ShortcutsEmptyState"
                                   Text="Clique em Procurar atalhos quebrados."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="ShortcutsList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline do DuplicatesList/StartupList. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LocationLabel}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding TargetLabel}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="ShortcutsSummary"
                                       FontSize="12.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />

                            <Button Grid.Column="1" x:Name="ShortcutsRecycleButton"
                                    Content="Remover selecionados (0)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="ShortcutsRecycle_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Aplicativos -->
            <Grid x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />      <!-- atualizações -->
                    <RowDefinition Height="Auto" />   <!-- desinstalação -->
                </Grid.RowDefinitions>

                <!-- Atualizações -->
                <Border Grid.Row="0"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="AppsStatusText"
                                       FontSize="12" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />

                            <Button Grid.Column="1" x:Name="AppsCancelButton"
                                    Content="Cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed"
                                    Click="AppsCancel_Click" />

                            <Button Grid.Column="2" x:Name="AppsScanButton"
                                    Content="Procurar atualizações"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    IsEnabled="False"
                                    Click="AppsScan_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <ProgressBar Grid.Row="1" x:Name="AppsProgress" Height="4"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="{StaticResource Bg}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="18,14,18,0" />

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="AppsEmptyState"
                                   Text="Clique em Procurar atualizações."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="AppsList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline do DuplicatesList/StartupList. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Id}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding VersionsLabel}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Atualizar"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="12,6" FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Click="AppsUpdateOne_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="AppsSummary"
                                       FontSize="12.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />

                            <Button Grid.Column="1" x:Name="AppsUpdateAllButton"
                                    Content="Atualizar tudo"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="AppsUpdateAll_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

                <!-- Desinstalar programas -->
                <Border Grid.Row="1" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Desinstalar programas"
                                   FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Fg}" />
                        <TextBlock Text="Remove programas instalados neste PC via winget."
                                   FontSize="12.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="UninsStatusText"
                                       Text="Clique em Carregar lista para exibir os programas instalados."
                                       FontSize="11.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />

                            <TextBox Grid.Column="1" x:Name="UninsFilterBox"
                                     Width="200"
                                     Background="{StaticResource Bg}"
                                     Foreground="{StaticResource Fg}"
                                     BorderBrush="{StaticResource Line}"
                                     BorderThickness="1" Padding="10,8"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                     TextChanged="UninsFilter_TextChanged" />

                            <Button Grid.Column="2" x:Name="UninsLoadButton"
                                    Content="Carregar lista"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    Click="UninsLoad_Click" />
                        </Grid>

                        <ListBox x:Name="UninsList" Margin="0,12,0,0" MaxHeight="320"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline das demais listas. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="2,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VersionLabel}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="{Binding ActionLabel}"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="12,6" FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Click="UninsItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Arquivos grandes -->
            <Border x:Name="LargeFilesPanel" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock x:Name="LargeFolderText"
                                           FontSize="11.5" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="LargeStatusText"
                                           FontSize="12" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="LargePickButton"
                                    Content="Escolher pasta…"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    VerticalAlignment="Center"
                                    Click="LargePick_Click" />

                            <!-- Sem estilo de ComboBox no app: ajuste mínimo inline
                                 para o controle não destoar do tema escuro. -->
                            <ComboBox Grid.Column="2" x:Name="LargeSizeCombo"
                                      Width="94" Margin="10,0,0,0"
                                      SelectedIndex="1"
                                      FontSize="12.5"
                                      Background="{StaticResource Bg}"
                                      Foreground="{StaticResource Fg}"
                                      BorderBrush="{StaticResource Line}"
                                      BorderThickness="1"
                                      Padding="8,6"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      ToolTip="Tamanho mínimo do arquivo">
                                <ComboBox.ItemContainerStyle>
                                    <!-- O popup do combo é claro: texto escuro para seguir legível. -->
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#0B0F14" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="50 MB" />
                                <ComboBoxItem Content="100 MB" />
                                <ComboBoxItem Content="500 MB" />
                                <ComboBoxItem Content="1 GB" />
                            </ComboBox>

                            <Button Grid.Column="3" x:Name="LargeScanButton"
                                    Content="Procurar"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="LargeScan_Click" />

                            <Button Grid.Column="4" x:Name="LargeCancelButton"
                                    Content="Cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="LargeCancel_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <ProgressBar Grid.Row="1" x:Name="LargeProgress" Height="4"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="{StaticResource Bg}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="18,14,18,0" />

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="LargeEmptyState"
                                   Text="Escolha uma pasta e clique em Procurar."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="LargeFilesList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline do AppsList/ShortcutsList. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" MinWidth="110"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource Fg}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding DateDisplay}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="LargeSummary"
                                       FontSize="12.5" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />

                            <Button Grid.Column="1" x:Name="LargeRecycleButton"
                                    Content="Remover selecionados (0)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="LargeRecycle_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Espaço em disco -->
            <Border x:Name="SpacePanel" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- barra de ferramentas -->
                        <RowDefinition Height="Auto" />   <!-- progresso -->
                        <RowDefinition Height="*" />      <!-- lista -->
                        <RowDefinition Height="Auto" />   <!-- rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Barra de ferramentas -->
                    <Border Grid.Row="0" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock x:Name="SpacePathText"
                                           FontSize="11.5" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="SpaceStatusText"
                                           FontSize="12" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="SpaceUpButton"
                                    Content="↑ Voltar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    VerticalAlignment="Center"
                                    Click="SpaceUp_Click" />

                            <Button Grid.Column="2" x:Name="SpacePickButton"
                                    Content="Escolher pasta…"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="SpacePick_Click" />

                            <Button Grid.Column="3" x:Name="SpaceScanButton"
                                    Content="Analisar"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="SpaceScan_Click" />

                            <Button Grid.Column="4" x:Name="SpaceCancelButton"
                                    Content="Cancelar"
                                    Style="{StaticResource GhostButton}"
                                    Padding="14,7" FontSize="12.5"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="SpaceCancel_Click" />
                        </Grid>
                    </Border>

                    <!-- Progresso -->
                    <ProgressBar Grid.Row="1" x:Name="SpaceProgress" Height="4"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="{StaticResource Bg}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Margin="18,14,18,0" />

                    <!-- Resultados -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="SpaceEmptyState"
                                   Text="Escolha uma pasta e clique em Analisar."
                                   FontSize="13.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="460" Margin="30" />

                        <ListBox x:Name="SpaceList" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,4"
                                 SelectionMode="Single"
                                 IsSynchronizedWithCurrentItem="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="SpaceList_MouseDoubleClick"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <!-- Mesmo reset inline das demais listas. -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12" BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Fg}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="4" Margin="0,6,0,0"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             Background="{StaticResource Bg}"
                                                             Foreground="{StaticResource Accent}"
                                                             BorderThickness="0"
                                                             HorizontalAlignment="Stretch" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" MinWidth="110"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource Fg}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding CountDisplay}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding PercentDisplay}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource Dim}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="3" Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="18,12">
                        <TextBlock x:Name="SpaceSummary"
                                   FontSize="12.5" Foreground="{StaticResource Dim}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Barra de status -->
            <Border Grid.Row="2" x:Name="StatusBar" Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="18,13" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionSummary" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                        <TextBlock x:Name="SelectionNote" FontSize="12"
                                   Foreground="{StaticResource Dim}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="RestorePointCheck"
                                  Content="Criar ponto de restauração antes de limpar"
                                  Foreground="{StaticResource Dim}" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Cursor="Hand"
                                  ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="RescanButton" Content="Analisar de novo"
                                Style="{StaticResource GhostButton}"
                                Click="Rescan_Click" Margin="0,0,10,0" />
                        <Button x:Name="CleanButton" Content="Limpar selecionados"
                                Style="{StaticResource PrimaryButton}"
                                Click="Clean_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ Rodapé ══════════════ -->
        <Border Grid.Row="3" Padding="28,13" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Background="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterText"
                           FontSize="11.5" Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Systenclin 0.8 — arquivos vão para a Lixeira; dados de navegador têm backup automático." />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <TextBlock x:Name="FooterCpuText" Text="CPU —"
                               FontSize="11.5" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="11.5"
                               Foreground="{StaticResource Dim}"
                               Margin="7,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterMemText" Text="RAM —"
                               FontSize="11.5" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BackupsButton" Content="Backups"
                            Style="{StaticResource GhostButton}"
                            Padding="12,6" FontSize="12"
                            Click="Backups_Click" Margin="0,0,8,0" />
                    <Button x:Name="HistoryButton" Content="Histórico"
                            Style="{StaticResource GhostButton}"
                            Padding="12,6" FontSize="12"
                            Click="History_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
